{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["supabase/functions/_shared/**/*.ts", "tests/unit/**/*.ts"],
  "exclude": ["supabase/functions/_shared/ai-clients.ts", "supabase/functions/_shared/auto-runner.ts"]
}
